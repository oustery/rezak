# EditorConfig: единые настройки для редакторов и IDE
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{dart,yaml,yml,json,md}]
indent_style = space
indent_size = 2

[*.kt]
indent_style = space
indent_size = 4

[*.gradle.kts]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
